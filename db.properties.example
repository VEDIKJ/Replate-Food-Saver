# ---- Replate database settings (TEMPLATE) ----
# 1. Copy this file to "db.properties" (in the same folder).
# 2. Fill in your own MySQL user and password.
# 3. db.properties is git-ignored so your real password is never committed.
#
# Alternatively, set the environment variables DB_URL, DB_USER and DB_PASSWORD
# instead of using this file - those take priority if present.

db.url=jdbc:mysql://localhost:3306/replate_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
db.user=root
db.password=YOUR_MYSQL_PASSWORD_HERE
